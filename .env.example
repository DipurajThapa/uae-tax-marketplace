# Copy to .env.local. Never commit real secrets.
DATABASE_URL=postgresql://app:app@localhost:5432/marketplace_dev
# Secret for hashing IPs and signing internal tokens (>=32 chars). Generate: openssl rand -hex 32
APP_SECRET=change-me-dev-only-0000000000000000000000
# Public base URL used for canonical links and sitemap
SITE_URL=http://localhost:3000
# Indexing is OFF until the owner authorizes launch. "true" allows crawlers.
ALLOW_INDEXING=false
# Synthetic demo data may be shown only in dev/test. Production must be false.
ALLOW_SYNTHETIC_DATA=true
# Email transport: "outbox-file" (writes to var/mail) or "smtp" (needs SMTP_URL)
MAIL_TRANSPORT=outbox-file
SMTP_URL=
MAIL_FROM=no-reply@example.invalid
# Billing: "test" (internal test-mode ledger). Live provider not configured.
BILLING_PROVIDER=test
# Private staging only: APP_ENV=staging plus STAGING_BASIC_AUTH="user:long-random-password" (>= 16 chars).
# Without it a staging deploy serves nothing (fail closed). Generate: echo "owner:$(openssl rand -hex 16)"
APP_ENV=
STAGING_BASIC_AUTH=
